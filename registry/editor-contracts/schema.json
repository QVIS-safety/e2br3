{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["pageId", "registryFile", "fields"],
  "additionalProperties": false,
  "properties": {
    "pageId": { "type": "string" },
    "registryFile": { "type": "string" },
    "fieldChecks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/behaviorCheck"
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/behaviorCheck"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/behaviorCheck"
      }
    },
    "auditChecks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/behaviorCheck"
      }
    },
    "rowIdentities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "requestPath",
          "keys"
        ],
        "additionalProperties": false,
        "properties": {
          "requestPath": {
            "type": "string",
            "minLength": 1
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "required"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "rowPrerequisites": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "authority", "frontendPath", "payloadPath", "projectionPath", "patch", "roundTripValue"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string" },
          "authority": { "enum": ["ICH", "FDA", "MFDS"] },
          "frontendPath": { "type": "string" },
          "payloadPath": { "type": "string", "minLength": 1 },
          "projectionPath": { "type": "string" },
          "patch": {
            "type": "object",
            "required": ["kind", "owner"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["row", "rows"] },
              "owner": { "type": "string", "minLength": 1 }
            }
          },
          "fixture": {},
          "rowsFixture": { "type": "object" },
          "roundTripValue": {},
          "control": {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["async_autocomplete", "native_select", "product_presave_picker", "radio_group", "radix_select", "string_checkbox"] },
              "queryValue": { "type": "string", "minLength": 1 },
              "optionValue": { "type": "string", "minLength": 1 },
              "optionDataValue": { "type": "string", "minLength": 1 },
              "optionLabel": { "type": "string", "minLength": 1 },
              "selectedLabel": { "type": "string", "minLength": 1 },
              "selectionRule": { "enum": ["exact_query_equal_first_source_order"] },
              "sourceCode": { "type": "string", "minLength": 1 },
              "sourceVersion": { "type": "string", "minLength": 1 },
              "sourceLanguage": { "type": "string", "minLength": 1 },
              "selectionEffects": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["frontendPath", "value"],
                  "additionalProperties": false,
                  "properties": {
                    "frontendPath": { "type": "string", "minLength": 1 },
                    "value": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "checkedValue": { "type": "string", "minLength": 1 },
              "uncheckedValue": { "type": "string" },
              "permissionActions": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["value", "label"],
                  "additionalProperties": false,
                  "properties": {
                    "value": { "type": "string", "minLength": 1 },
                    "label": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "dynamicOptions": {
                "type": "object",
                "required": ["source", "valuePath", "labelPath"],
                "additionalProperties": false,
                "properties": {
                  "source": { "type": "string", "minLength": 1 },
                  "valuePath": { "type": "string", "minLength": 1 },
                  "labelPath": { "type": "string", "minLength": 1 }
                }
              }
            },
            "allOf": [
              {
                "if": { "properties": { "kind": { "const": "radix_select" } } },
                "then": {
                  "oneOf": [
                    {
                      "required": ["options"],
                      "not": { "required": ["dynamicOptions"] }
                    },
                    {
                      "required": ["dynamicOptions"],
                      "not": { "required": ["options"] }
                    }
                  ]
                }
              },
              {
                "if": { "properties": { "kind": { "const": "native_select" } } },
                "then": { "required": ["options"] }
              },
              {
                "if": { "properties": { "kind": { "const": "radio_group" } } },
                "then": { "required": ["options"] }
              },
              {
                "if": { "properties": { "kind": { "const": "product_presave_picker" } } },
                "then": { "required": ["permissionActions"] }
              },
              {
                "if": { "properties": { "kind": { "const": "async_autocomplete" } } },
                "then": { "required": ["queryValue", "optionValue", "optionDataValue", "optionLabel", "selectedLabel"] }
              },
              {
                "if": { "properties": { "kind": { "const": "string_checkbox" } } },
                "then": { "required": ["checkedValue", "uncheckedValue"] }
              }
            ]
          },
          "scenarioControls": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "mfds-g-product-required": {
                "type": "object",
                "required": ["kind", "productionReference"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "const": "mfds_product_direct_input" },
                  "productionReference": { "const": "mfdsProduct.item_seq" }
                }
              },
              "mfds-g-substance-version-required": {
                "type": "object",
                "required": ["kind", "productionReference"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "const": "mfds_foreign_substance_direct_input" },
                  "productionReference": { "const": "whoSubstance.code" }
                }
              }
            }
          },
          "execution": {
            "type": "object",
            "required": ["status", "reason"],
            "additionalProperties": false,
            "properties": {
              "status": { "enum": ["blocked"] },
              "reason": { "type": "string", "minLength": 1 },
              "prerequisites": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1
              }
            }
          },
          "projectionValue": {},
          "domFieldNumber": { "type": "string", "minLength": 1 },
          "auditItem": { "type": "string", "minLength": 1 },
          "renderPrerequisites": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["code", "frontendPath", "value"],
              "additionalProperties": false,
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "frontendPath": { "type": "string", "minLength": 1 },
                "value": { "type": ["string", "null"] }
              }
            }
          },
          "nullFlavorPartnerCode": { "type": "string", "minLength": 1 },
          "persistence": { "$ref": "#/$defs/persistence" },
          "constraint": { "$ref": "#/$defs/stage" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pageId": {
            "not": {
              "const": "N"
            }
          }
        }
      },
      "then": {
        "required": [
          "fieldChecks",
          "collections",
          "relations",
          "auditChecks",
          "rowIdentities"
        ],
        "properties": {
          "fields": {
            "items": {
              "allOf": [
                {
                  "if": {
                    "not": {
                      "required": [
                        "execution"
                      ]
                    }
                  },
                  "then": {
                    "required": [
                      "persistence"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "clearOutcome": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "effect",
            "input",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "effect": {
              "const": "store"
            },
            "input": {},
            "value": {}
          }
        },
        {
          "type": "object",
          "required": [
            "effect",
            "input",
            "status",
            "ruleCode"
          ],
          "additionalProperties": false,
          "properties": {
            "effect": {
              "const": "reject"
            },
            "input": {},
            "status": {
              "const": 422
            },
            "ruleCode": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "auditBinding": {
      "type": "object",
      "required": [
        "table",
        "column",
        "record"
      ],
      "additionalProperties": false,
      "properties": {
        "table": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "column": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "record": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "source"
              ],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "const": "case"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "source",
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "const": "projection"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": [
        "clear",
        "blank",
        "omission",
        "audit"
      ],
      "additionalProperties": false,
      "properties": {
        "clear": {
          "$ref": "#/$defs/clearOutcome"
        },
        "blank": {
          "oneOf": [
            {
              "$ref": "#/$defs/clearOutcome"
            },
            {
              "type": "object",
              "required": [
                "effect",
                "reason"
              ],
              "additionalProperties": false,
              "properties": {
                "effect": {
                  "const": "not_applicable"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "omission": {
          "oneOf": [
            {
              "const": "preserve"
            },
            {
              "type": "object",
              "required": [
                "effect",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "effect": {
                  "const": "store"
                },
                "value": {}
              }
            },
            {
              "type": "object",
              "required": [
                "effect",
                "status",
                "error",
                "detail"
              ],
              "additionalProperties": false,
              "properties": {
                "effect": {
                  "const": "reject"
                },
                "status": {
                  "const": 400
                },
                "error": {
                  "const": "INVALID_REQUEST"
                },
                "detail": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "audit": {
          "$ref": "#/$defs/auditBinding"
        }
      }
    },
    "behaviorCheck": {
      "type": "object",
      "required": [
        "id",
        "verifier",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "verifier": {
          "type": "string",
          "pattern": "^(fields|rows|relations|audit)::[a-z][a-z0-9_]*::[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "minProperties": 1
        },
        "audit": {
          "$ref": "#/$defs/auditBinding"
        }
      }
    },
    "stage": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["verified", "not_applicable", "blocked"] },
        "ruleCode": { "type": "string" },
        "issuePath": { "type": "string" },
        "reason": { "type": "string" },
        "invalidValue": {}
      }
    }
  }
}
